{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c0caf5",
    "margin": 2
  },
  "block_quote": {
    "color": "#565f89",
    "italic": true,
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "color": "#c0caf5",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#7aa2f7",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "color": "#7aa2f7",
    "background_color": "#24293b"
  },
  "h2": {
    "prefix": "## ",
    "color": "#e0af68",
    "background_color": "#2e2a2d"
  },
  "h3": {
    "prefix": "### ",
    "color": "#9ece6a",
    "background_color": "#272d2d"
  },
  "h4": {
    "prefix": "#### ",
    "color": "#1abc9c",
    "background_color": "#1a2b32"
  },
  "h5": {
    "prefix": "##### ",
    "color": "#bb9af7",
    "background_color": "#2a283b"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#9d7cd8",
    "background_color": "#272538"
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#ff9e64",
    "format": "\n--------\n"
  },
  "item": {
    "prefix": "• ",
    "color": "#ff9e64",
    "bold": true
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#1abc9c",
    "underline": true
  },
  "link_text": {
    "color": "#2ac3de"
  },
  "image": {
    "color": "#1abc9c",
    "underline": true
  },
  "image_text": {
    "color": "#2ac3de",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "color": "#7aa2f7",
    "background_color": "#414868"
  },
  "code_block": {
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#c0caf5"
      },
      "error": {
        "color": "#db4b4b"
      },
      "comment": {
        "color": "#565f89",
        "italic": true
      },
      "comment_preproc": {
        "color": "#7dcfff"
      },
      "keyword": {
        "color": "#9d7cd8",
        "italic": true
      },
      "keyword_reserved": {
        "color": "#bb9af7"
      },
      "keyword_namespace": {
        "color": "#7dcfff"
      },
      "keyword_type": {
        "color": "#27a1b9"
      },
      "operator": {
        "color": "#89ddff"
      },
      "punctuation": {
        "color": "#a9b1d6"
      },
      "name": {
        "color": "#c0caf5"
      },
      "name_builtin": {
        "color": "#2ac3de"
      },
      "name_tag": {
        "color": "#bb9af7"
      },
      "name_attribute": {
        "color": "#73daca"
      },
      "name_class": {
        "color": "#2ac3de"
      },
      "name_constant": {
        "color": "#ff9e64"
      },
      "name_decorator": {
        "color": "#7dcfff"
      },
      "name_exception": {
        "color": "#27a1b9"
      },
      "name_function": {
        "color": "#7aa2f7"
      },
      "name_other": {
        "color": "#c0caf5"
      },
      "literal": {
        "color": "#ff9e64"
      },
      "literal_number": {
        "color": "#ff9e64"
      },
      "literal_date": {
        "color": "#ff9e64"
      },
      "literal_string": {
        "color": "#9ece6a"
      },
      "literal_string_escape": {
        "color": "#bb9af7"
      },
      "generic_deleted": {
        "background_color": "#4a272f"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "background_color": "#243e4a"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#7aa2f7",
        "bold": true
      },
      "background": {
        "background_color": "#16161e"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
